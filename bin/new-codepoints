#!/usr/bin/env python3
"""List codepoints a font gained relative to an older build of the same font.

iOS font import is manual, so the release notes are the only place the reader
learns whether a re-import is worth doing.
"""

import argparse
import json
import sys

from sfnt import FontError, codepoints


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("old", metavar="OLD_FONT")
    parser.add_argument("new", metavar="NEW_FONT")
    parser.add_argument(
        "--names",
        metavar="GLYPHNAMES_JSON",
        help="nerd-fonts glyphnames.json, used to label each codepoint",
    )
    args = parser.parse_args()

    try:
        added = codepoints(args.new) - codepoints(args.old)
    except (FontError, OSError) as error:
        print("cannot compare fonts: {}".format(error), file=sys.stderr)
        return 1

    names = load_names(args.names) if args.names else {}
    for codepoint in sorted(added):
        print("- `U+{:04X}` {}".format(codepoint, names.get(codepoint, "")).rstrip())
    return 0


def load_names(path):
    with open(path) as glyphnames:
        entries = json.load(glyphnames)
    return {
        int(entry["code"], 16): name
        for name, entry in entries.items()
        if isinstance(entry, dict) and "code" in entry
    }


if __name__ == "__main__":
    sys.exit(main())
